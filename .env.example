# SecureVault Server Environment Configuration

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# JWT Authentication Secret Key (Generate a 64+ char random hex string in production)
JWT_SECRET=securevault-super-secret-dev-key-change-in-production-2026

# JWT Expiration Period
JWT_EXPIRES_IN=24h

# Database File Path (Default SQLite path)
DB_PATH=./server/securevault.db

# Private Vault Storage Directory (Directory storing raw encrypted ciphertext blobs)
VAULT_STORAGE_DIR=./server/vault_storage

# Frontend Client URL (For CORS whitelist)
CLIENT_URL=http://localhost:5173

# Maximum Upload Size (Bytes, default 100MB = 104857600)
MAX_UPLOAD_SIZE_BYTES=104857600

# Frontend Configuration (Optional: set for frontend build if backend is on a separate domain)
# VITE_API_BASE_URL=https://api.yourdomain.com
